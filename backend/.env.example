# Environment Configuration
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Local MongoDB OR MongoDB Atlas)
# ------------------------------------------------------------------------------
# Option A: Local MongoDB (Default)
MONGO_URI=mongodb://localhost:27017/escape_room

# Option B: MongoDB Atlas (Cloud)
# 1. Create a free cluster on https://cloud.mongodb.com
# 2. Add your current IP address to the Network Access IP Access List
# 3. Create a Database User (username and password)
# 4. Copy the connection string (Choose "Drivers" -> Node.js) and paste below:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/escape_room?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Generate strong, distinct 32+ character keys for production (e.g. using `openssl rand -hex 32`)
JWT_SECRET=super_secret_jwt_key_minimum_32_characters_long_for_security
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_minimum_32_characters_long

# ------------------------------------------------------------------------------
# CLIENT CORS WHITELIST
# ------------------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173
